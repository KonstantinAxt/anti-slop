{
  "name": "anti-slop",
  "version": "0.1.40",
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=10.34.5"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "anti-slop": "./bin/anti-slop"
  },
  "scripts": {
    "build": "esbuild bin/anti-slop.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "check:size": "node scripts/check-bundle-size.mjs",
    "test:installer": "bash scripts/test-installer.sh",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node ./bin/anti-slop --mutation",
    "test:mutation:preflight": "node --import tsx scripts/mutation-preflight.ts",
    "test:crap": "node ./bin/anti-slop --crap"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/instrumenter": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-plugin-barrel-files": "^3.0.1",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-jsdoc": "^64.3.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-test-smells": "^1.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-use-client": "^1.2.0",
    "jscpd": "^5.2.0",
    "picomatch": "^4.0.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/bun": "latest",
    "@types/estree": "^1.0.6",
    "@types/node": "^22.13.10",
    "@types/picomatch": "^3.0.2",
    "@vitest/coverage-v8": "^3.2.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.1.14",
    "tsx": "^4.23.13",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "vitest"
    ],
    "patchedDependencies": {
      "vitest": "patches/vitest.patch"
    }
  }
}
