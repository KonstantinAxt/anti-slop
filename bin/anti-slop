#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const distCli = path.join(__dirname, "../dist/cli.js");
const cliTs = path.join(__dirname, "anti-slop.ts");
const srcDir = path.join(__dirname, "../src");

function isDistStale(distPath, cliTsPath, srcDirPath) {
  try {
    if (!fs.existsSync(cliTsPath)) {
      return false;
    }

    const distMtime = fs.statSync(distPath).mtimeMs;

    if (fs.statSync(cliTsPath).mtimeMs > distMtime) {
      return true;
    }

    if (fs.existsSync(srcDirPath)) {
      const entries = fs.readdirSync(srcDirPath, { recursive: true, withFileTypes: true });

      for (const entry of entries) {
        if (entry.isFile()) {
          const parent = entry.parentPath ?? entry.path ?? srcDirPath;
          const fullPath = path.join(parent, entry.name);

          try {
            if (fs.statSync(fullPath).mtimeMs > distMtime) {
              return true;
            }
          } catch {
            // Ignore unreadable files
          }
        }
      }
    }

    return false;
  } catch {
    return false;
  }
}

if (process.env.ANTI_SLOP_FORCE_SOURCE !== "true") {
  try {
    if (fs.existsSync(distCli) && !isDistStale(distCli, cliTs, srcDir)) {
      await import(distCli);
      process.exit(process.exitCode ?? 0);
    }
  } catch {
    // Fall through to tsx loader if dist import fails or dist is stale
  }
}

const tsxLoader = import.meta.resolve("tsx");

const result = spawnSync(
  process.execPath,
  ["--import", tsxLoader, cliTs, ...process.argv.slice(2)],
  { stdio: "inherit" }
);
process.exit(result.status ?? 0);
